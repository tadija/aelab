#!/bin/sh
# Repository entrypoint for the compiled aelab administrative CLI.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

if [ "${1:-}" = "--home" ] && [ "${3:-}" = "run" ]; then
  run_home=$2
  shift 3
  set -- run --home "$run_home" "$@"
fi
case "${1:-}" in
  daemon-install)
    shift
    # Keep caller-relative paths meaningful when building inside the checkout.
    (cd "$root" && swift build -c release --product aelab-daemon)
    exec "$root/.build/release/aelab-daemon" install "$@"
    ;;
  run|install)
    build_configuration=release
    operation=$1
    shift
    validate_options() {
      while [ "$#" -gt 0 ]; do
        if [ "$operation:$1" = "run:--debug" ]; then build_configuration=debug; shift; continue; fi
        if [ "$#" -lt 2 ]; then printf '%s\n' 'An option value is missing' >&2; exit 1; fi
        case "$operation:$1" in
          run:--home|install:--prefix) [ -n "$2" ] || { printf '%s\n' 'Path must not be empty' >&2; exit 1; } ;;
          run:--configuration)
            case "$2" in debug|release) build_configuration=$2 ;; *) printf '%s\n' 'Configuration must be debug or release' >&2; exit 1 ;; esac ;;
          run:--port)
            case "$2" in ''|*[!0-9]*) printf '%s\n' 'Invalid port' >&2; exit 1 ;; esac
            if [ "${#2}" -gt 5 ] || [ "$2" -lt 1 ] || [ "$2" -gt 65535 ]; then printf '%s\n' 'Invalid port' >&2; exit 1; fi ;;
          *) printf '%s\n' 'Use ./.ae run [--debug | --configuration debug|release] [--home PATH] [--port PORT] or ./.ae install [--prefix PATH]' >&2; exit 1 ;;
        esac
        shift 2
      done
    }
    validate_options "$@"
    # CLI argument paths must retain their meaning when builds change directory.
    caller_directory=$PWD
    (cd "$root" && python3 Scripts/generate-api.py && swift build -c "$build_configuration" && npm ci --prefix Frontend && if [ "$build_configuration" = debug ]; then npm run build --prefix Frontend -- --mode development --sourcemap; else npm run build --prefix Frontend; fi)
    cd "$caller_directory"
    if [ "$operation" = "install" ]; then
      exec "$root/.build/release/aelab" install --source "$root" "$@"
    fi
    export AELAB_PUBLIC="${AELAB_PUBLIC:-$root/Frontend/dist}"
    # Build configuration belongs to this repository wrapper, not the installed CLI.
    filtered_count=$#
    while [ "$filtered_count" -gt 0 ]; do
      flag=$1; shift; filtered_count=$((filtered_count - 1))
      if [ "$flag" = "--debug" ]; then continue; fi
      value=$1; shift; filtered_count=$((filtered_count - 1))
      if [ "$flag" != "--configuration" ]; then set -- "$@" "$flag" "$value"; fi
    done
    exec "$root/.build/$build_configuration/aelab" run "$@"
    ;;
esac

for configuration in release debug; do
  binary="$root/.build/$configuration/aelab"
  if [ -x "$binary" ]; then exec "$binary" "$@"; fi
done
printf '%s\n' 'Build first: swift build --product aelab; or run ./.ae run' >&2
exit 1
