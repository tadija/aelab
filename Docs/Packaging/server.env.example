AELAB_HOME=/var/lib/aelab
AELAB_PUBLIC=/usr/local/share/aelab/current/public
AELAB_BIND=127.0.0.1
AELAB_PORT=2108
AELAB_ORIGIN=https://lab.example.com
# Optional URL prefix; configure the proxy to preserve it:
# AELAB_BASE_PATH=/aelab
# Optional stable SSH-agent socket; provision before starting aelab:
# SSH_AUTH_SOCK=/run/aelab-ssh-agent/agent.sock
